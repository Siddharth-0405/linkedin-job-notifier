# ============================================================
#  LinkedIn Job Notifier — Configuration
#  ============================================================
#  HOW TO USE:
#  1. Copy this file and rename it to .env  (remove the .example part)
#  2. Fill in your values below
#  3. Run: python job_notifier.py
# ============================================================


# ── What jobs to search for ───────────────────────────────────
# Comma-separated list of job titles to search
# Examples:
#   JOB_KEYWORDS=Data Engineer
#   JOB_KEYWORDS=Data Engineer,Software Engineer
#   JOB_KEYWORDS=Data Analyst,ML Engineer,Backend Engineer
JOB_KEYWORDS=Data Engineer,Software Engineer


# ── Where to search ───────────────────────────────────────────
# Use pipe | to separate cities (not comma, since city names have commas)
# Examples:
#   JOB_LOCATIONS=Bengaluru, India
#   JOB_LOCATIONS=Bengaluru, India|Hyderabad, India
#   JOB_LOCATIONS=Mumbai, India|Pune, India|Remote
#   JOB_LOCATIONS=New York, USA|San Francisco, USA
JOB_LOCATIONS=Bengaluru, India|Hyderabad, India


# ── Experience level ──────────────────────────────────────────
# Choose ONE of these values:
#   internship  = Internship (0 years)
#   entry       = Entry Level (0-1.5 years)   ← recommended for freshers
#   associate   = Associate (1-3 years)
#   mid_senior  = Mid-Senior Level (3-5 years)
#   any         = No filter (shows all levels)
EXPERIENCE_LEVEL=entry


# ── Easy Apply filter ─────────────────────────────────────────
# true  = Only show jobs with LinkedIn Easy Apply button (recommended)
# false = Show all jobs including those on company websites
EASY_APPLY_ONLY=true


# ── How often to check ────────────────────────────────────────
# Time in minutes between each check (minimum recommended: 10)
CHECK_INTERVAL=15


# ── Title include filter ──────────────────────────────────────
# Job title MUST contain at least one of these words
# Comma-separated, case-insensitive
# Examples:
#   TITLE_INCLUDE=data engineer
#   TITLE_INCLUDE=data engineer,software engineer
#   TITLE_INCLUDE=data analyst,data engineer,ml engineer
TITLE_INCLUDE=data engineer,software engineer


# ── Title exclude filter ──────────────────────────────────────
# Job title must NOT contain any of these words (blocks senior/lead roles)
# Add or remove words as needed
# Examples:
#   TITLE_EXCLUDE=senior,lead,manager          ← less strict
#   TITLE_EXCLUDE=senior,sr.,lead,principal,staff,manager,head,director,architect
TITLE_EXCLUDE=senior,sr.,lead,principal,staff,manager,head,director,architect,vp,vice president,team lead


# ── Desktop notifications ─────────────────────────────────────
# true = show a popup on your screen when new jobs are found
DESKTOP_NOTIFY=true


# ─────────────────────────────────────────────────────────────
#  EMAIL NOTIFICATIONS (optional)
#  To enable: set EMAIL_NOTIFY=true and fill in the fields below
# ─────────────────────────────────────────────────────────────
EMAIL_NOTIFY=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com


# ─────────────────────────────────────────────────────────────
#  TELEGRAM NOTIFICATIONS (optional)
#  To enable:
#    1. Message @BotFather on Telegram -> /newbot -> copy token below
#    2. Message @userinfobot on Telegram -> copy your id below
#    3. Set TELEGRAM_NOTIFY=true
# ─────────────────────────────────────────────────────────────
TELEGRAM_NOTIFY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
